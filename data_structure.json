  "services": {
    "description": "Serviços oferecidos por cada profissional",
    "fields": {
      "userId": "string - ID do profissional (referência)",
      "name": "string - Nome do serviço",
      "duration": "number - Duração em minutos",
      "price": "number - Preço em reais",
      "description": "string - Descrição do serviço",
      "color": "string - Cor em hex (ex: #10B981)",
      "active": "boolean - Serviço está ativo?",
      "createdAt": "timestamp"
    },
    "examples": [
      {
        "userId": "demo-profissional-001",
        "name": "Corte de Cabelo",
        "duration": 30,
        "price": 35.0,
        "description": "Corte masculino",
        "color": "#10B981",
        "active": true
      },
      {
        "userId": "demo-profissional-001",
        "name": "Barba",
