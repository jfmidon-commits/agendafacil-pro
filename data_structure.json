{
  "users": {
    "description": "Profissionais autônomos cadastrados",
    "fields": {
      "name": "string - Nome completo",
      "email": "string - E-mail de login",
      "phone": "string - WhatsApp com +55",
      "slug": "string - Link personalizado (ex: carlos-barbearia)",
      "businessName": "string - Nome do negócio",
      "businessDescription": "string - Descrição do negócio",
      "avatar": "string - URL da foto",
      "address": "string - Endereço do atendimento",
      "city": "string - Cidade",
      "plan": "string - free | pro | studio",
      "trialEndsAt": "timestamp - Fim do trial",
      "subscriptionStatus": "string - active | cancelled | past_due",
      "workingHours": "map - Horários de cada dia da semana",
      "slotDuration": "number - Minutos entre agendamentos (15, 30, 45, 60)",
      "createdAt": "timestamp",
      "updatedAt": "timestamp"
    },
