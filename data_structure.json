        "userId": "demo-profissional-001",
        "name": "Corte + Barba",
        "duration": 45,
        "price": 55.0,
        "description": "Combo",
        "color": "#F59E0B",
        "active": true
      }
    ]
  },
  "appointments": {
    "description": "Agendamentos de clientes",
    "fields": {
      "userId": "string - ID do profissional",
      "serviceId": "string - ID do serviço",
      "clientName": "string - Nome do cliente",
      "clientPhone": "string - WhatsApp do cliente",
      "clientEmail": "string - E-mail do cliente",
      "date": "string - Data no formato YYYY-MM-DD",
      "time": "string - Horário no formato HH:MM",
      "status": "string - confirmed | cancelled | completed | no-show",
      "notes": "string - Observações",
      "reminderSent": "boolean - Lembrete enviado?",
      "createdAt": "timestamp"
    },
    "example": {
      "userId": "demo-profissional-001",
      "serviceId": "service-001",
      "clientName": "João Pedro",
      "clientPhone": "+5511988888888",
      "clientEmail": "joao@email.com",
      "date": "2026-08-29",
      "time": "14:00",
      "status": "confirmed",
      "notes": "Primeira vez",
      "reminderSent": false,
      "createdAt": "2026-08-28T00:00:00Z"
    }
  },
  "subscriptions": {
    "description": "Assinaturas Stripe dos usuários",
    "fields": {
      "userId": "string - ID do usuário",
      "stripeCustomerId": "string - ID do cliente no Stripe",
      "stripeSubscriptionId": "string - ID da assinatura no Stripe",
      "plan": "string - pro | studio",
      "status": "string - active | cancelled | past_due",
      "currentPeriodStart": "timestamp",
      "currentPeriodEnd": "timestamp",
      "cancelAtPeriodEnd": "boolean",
      "createdAt": "timestamp"
    }
  }
}