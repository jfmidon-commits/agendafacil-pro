{
  "users": {
    "description": "DADOS PRIVADOS do profissional (apenas dono acessa)",
    "fields": {
      "name": "string - Nome completo",
      "email": "string - E-mail de login",
      "phone": "string - WhatsApp com +55",
      "plan": "string - free | pro | studio",
      "trialStatus": "string - active | ended | never",
      "trialEndsAt": "timestamp - Fim do trial",
      "subscriptionStatus": "string - active | cancelled | past_due",
      "stripeCustomerId": "string - ID do cliente Stripe",
      "createdAt": "timestamp",
      "updatedAt": "timestamp"
    }
  },
  "publicProfiles": {
    "description": "DADOS PÚBLICOS do profissional (qualquer um vê)",
    "fields": {
      "userId": "string - Referência ao documento users",
      "slug": "string - URL amigável (ex: carlos-barbearia)",
      "businessName": "string - Nome do negócio",
      "businessDescription": "string - Descrição",
      "avatar": "string - URL da foto",
      "address": "string - Endereço",
      "city": "string - Cidade",
      "state": "string - Estado (ex: SP)",
      "workingHours": "map - Horários por dia da semana",
      "slotDuration": "number - Minutos entre agendamentos",
      "bufferBefore": "number - Minutos de buffer antes",
      "bufferAfter": "number - Minutos de buffer depois",
      "timezone": "string - Fuso horário (ex: America/Sao_Paulo)",
      "isActive": "boolean - Perfil está ativo?",
      "createdAt": "timestamp",
      "updatedAt": "timestamp"
    }
  },
  "services": {
    "description": "Serviços oferecidos",
    "fields": {
      "userId": "string - ID do profissional",
      "name": "string - Nome do serviço",
      "duration": "number - Duração em minutos",
      "price": "number - Preço em reais",
      "description": "string - Descrição",
      "color": "string - Cor em hex",
      "bufferBefore": "number - Buffer antes (min)",
      "bufferAfter": "number - Buffer depois (min)",
      "active": "boolean",
      "createdAt": "timestamp"
    }
  },
  "availabilityRules": {
    "description": "Regras de disponibilidade por dia da semana",
    "fields": {
      "userId": "string - ID do profissional",
      "dayOfWeek": "number - 0=Dom, 1=Seg, ..., 6=Sab",
      "dayName": "string - Nome do dia",
      "startTime": "string - HH:MM",
      "endTime": "string - HH:MM",
      "isAvailable": "boolean - Dia está disponível?",
      "slotDuration": "number - Minutos entre slots",
      "bufferBefore": "number - Minutos",
      "bufferAfter": "number - Minutos",
      "createdAt": "timestamp"
    }
  },
  "scheduleBlocks": {
    "description": "Bloqueios específicos (folga, almoço, indisponível)",
    "fields": {
      "userId": "string - ID do profissional",
      "startAt": "timestamp - Início do bloqueio",
      "endAt": "timestamp - Fim do bloqueio",
      "reason": "string - Motivo",
      "type": "string - break | timeoff | blocked",
      "createdAt": "timestamp"
    }
  },
  "appointments": {
    "description": "Agendamentos v2.0 (APENAS via API /api/book)",
    "fields": {
      "userId": "string - ID do profissional",
      "serviceId": "string - ID do serviço",
      "serviceName": "string - Snapshot do nome",
      "serviceDuration": "number - Snapshot da duração",
      "bufferBefore": "number - Snapshot",
      "bufferAfter": "number - Snapshot",
      "totalDuration": "number - Duração total calculada",
      "clientName": "string",
      "clientPhone": "string",
      "clientEmail": "string",
      "startsAt": "timestamp - Início do agendamento",
      "endsAt": "timestamp - Fim do agendamento",
      "timezone": "string - Fuso horário",
      "status": "string - confirmed | cancelled | completed | no-show",
      "notes": "string - Observações",
      "reminderSent": "boolean - Lembrete enviado?",
      "cancelledAt": "timestamp | null",
      "cancelledBy": "string - client | professional | null",
      "createdAt": "timestamp"
    }
  },
  "subscriptions": {
    "description": "Assinaturas Stripe (fonte oficial da verdade)",
    "fields": {
      "userId": "string - ID do usuário",
      "stripeCustomerId": "string",
      "stripeSubscriptionId": "string",
      "plan": "string - pro | studio",
      "status": "string - active | cancelled | past_due",
      "currentPeriodStart": "timestamp",
      "currentPeriodEnd": "timestamp",
      "cancelAtPeriodEnd": "boolean",
      "createdAt": "timestamp",
      "updatedAt": "timestamp"
    }
  }
}